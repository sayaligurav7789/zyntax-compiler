// Example 06: Full Optimization Pipeline (Fixpoint Convergence)
// Combines constant folding, constant propagation, algebraic identities,
// and dead code elimination iterating to a fixpoint.
// Expected program output: 120

int initial = 10;
int multiplier = 2;
int calculated = initial * multiplier; // 20
int deadTemp = calculated * 999;       // dead!
int adjusted = calculated + 0;         // simplified: 20
int scaled = adjusted * 6;             // folded: 120
print(scaled);
